# /opt/livekit/movers-bot/.env — copy to .env and fill in.
#
# SEPARATE from the other campaigns' .env files on purpose: this one posts to a different
# CRM. Keys that are genuinely shared (LiveKit, Deepgram, Anthropic) are duplicated here
# rather than symlinked, so rotating one campaign can never break another.
#
# The browser demo reads THIS FILE too (names, prices, voice), but overrides
# MACHINE_GUARD and blanks the webhook for demo calls — see WEB_DEMO.md.

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=APIKEY
LIVEKIT_API_SECRET=paste-the-same-secret-as-livekit.yaml

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ── Identity (all spoken) ────────────────────────────────────────────────────
COMPANY_NAME=EasyMove Removals
# The voice introduces itself by this name in the opening line, so set it deliberately.
AGENT_NAME=Jack
# Only used if a customer asks for a number to call back on. Leave blank and the bot says
# it will be on their booking confirmation.
CONTACT_NUMBER=

# ── Stack ────────────────────────────────────────────────────────────────────
STT_LANGUAGE=en-AU
# Aura-2's two Australian voices are theia (feminine) and hyperion (masculine).
# ⚠️ A wrong id returns 400 on EVERY turn, which sounds exactly like a mute bot —
# verify against Deepgram's current voice list before the first live call.
TTS_VOICE=aura-2-hyperion-en

# ── The rate card — REPLACE WITH THE CLIENT'S REAL PRICING ───────────────────
# bedrooms:movers:truck tonnes:hourly rate — one tier per comma, applied from that many
# bedrooms up. Every figure the bot speaks is worked out in code from these; the model is
# forbidden from inventing or rounding any of them.
MOVE_RATES=1:2:4.5:130,2:2:6:150,3:3:8:190,4:3:10:220
MIN_HOURS=3
CALLOUT_FEE=80
DEPOSIT=100
# 1 = the rates above INCLUDE GST ("150 dollars an hour, including GST").
# 0 = the bot says "plus GST" instead. Match how the client quotes customers.
RATES_INCLUDE_GST=1
BILLING_INCREMENT=15 minutes
CALL_AHEAD=30 minutes
# The only arrival windows the bot will ever offer. Pipe-separated, spoken as written.
ARRIVAL_WINDOWS=7 to 8 am|12 to 1 pm
# How the deposit can be paid AFTER the call. The bot never takes card details on the
# call, whatever this says.
PAYMENT_METHODS=bank transfer, BPAY or PayID

# ── Call behaviour ───────────────────────────────────────────────────────────
# The longest script we run: confirm, qualify, quote, book, read back.
# Keep TimeoutStopSec in movers-bot.service ABOVE this value.
MAX_CALL_SECONDS=480
NUDGE_AFTER=8

# ── Disposition — the whole reason this file is separate ─────────────────────
DISPOSITION_WEBHOOK_URL=
DISPOSITION_WEBHOOK_TOKEN=
DISPOSITION_CSV_PATH=/opt/livekit/movers-bot/disposition_movers.csv

# ── Worker identity. Change these only if you also change the dispatch rule. ─
MOVERS_AGENT_NAME=movers-bot
# 8081 smarthealth-bot, 8083 roof-bot, 8084 finance-bot, 8085 voicebot-web,
# 8087 warranty-bot. Must not collide.
MOVERS_WORKER_HTTP_PORT=8086
