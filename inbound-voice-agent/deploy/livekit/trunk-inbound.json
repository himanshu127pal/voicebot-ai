{
  "trunk": {
    "name": "inbound-callbacks",
    "numbers": ["inbound-ai"],
    "allowed_addresses": ["FREESWITCH_IP_REPLACE_ME"],
    "include_headers": "SIP_X_HEADERS",
    "headers_to_attributes": {
