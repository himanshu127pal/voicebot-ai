# Copy to .env and fill in. Never commit .env.

# ── LiveKit (must match livekit.yaml on the media host) ──────────────────────
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Model providers ──────────────────────────────────────────────────────────
# LLM for every campaign: google (Gemini, as Naina) or anthropic (Claude, as roof-bot)
LLM_PROVIDER=google
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Voice — only the stacks used in config/campaigns/ need a key
SARVAM_API_KEY=
DEEPGRAM_API_KEY=

# ── Campaigns ────────────────────────────────────────────────────────────────
# Directory of campaign YAML files. Default: ./config/campaigns
# INBOUND_CAMPAIGNS_DIR=/opt/livekit/inbound-voice-agent/config/campaigns
# Local testing only (`python -m inbound_agent console`): campaign key to use, since
# console mode has no DID. Ignored on real calls.
CONSOLE_CAMPAIGN=

# ── Human handoff (optional) ─────────────────────────────────────────────────
# SIP URI / tel: the caller is REFERred to. Blank = the agent offers a callback instead.
# A campaign can override it with `human_transfer_uri`.
HUMAN_TRANSFER_URI=

# ── Call behaviour ───────────────────────────────────────────────────────────
# Keep TimeoutStopSec in deploy/systemd/inbound-agent.service ABOVE this value.
MAX_CALL_SECONDS=300
NUDGE_AFTER_SECONDS=10
MAX_NUDGES=3

# ── Outcome delivery ─────────────────────────────────────────────────────────
# Backend endpoint that acts on do_not_call / whatsapp_opt_in / callbacks.
DISPOSITION_WEBHOOK_URL=
DISPOSITION_WEBHOOK_TOKEN=
# Every call (outcome + full transcript) appended as one JSON line.
TRANSCRIPT_LOG_PATH=./data/calls.jsonl

# ── Worker ───────────────────────────────────────────────────────────────────
# Must equal agent_name in deploy/livekit/dispatch-inbound.json
INBOUND_AGENT_NAME=inbound-bot
# Health-check port. 8081-8087 are used by the other workers on the shared box.
WORKER_HTTP_PORT=8088
NUM_IDLE_PROCESSES=2
