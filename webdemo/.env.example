# webdemo/.env — copy to .env and fill in.
# The key/secret MUST match keys: in /opt/livekit/livekit.yaml.

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=APIKEY
LIVEKIT_API_SECRET=paste-the-same-secret-as-livekit.yaml

# What the BROWSER connects to. No path — the SDK appends /rtc itself.
# Must be wss:// : an HTTPS page cannot open a ws:// socket, and getUserMedia
# (the microphone) is unavailable on anything but HTTPS or localhost.
PUBLIC_LIVEKIT_URL=wss://demo.btbiz.in

# Must match DEMO_AGENT_NAME in voicebot-web.service. NEVER a telephony bot's name
# (smarthealth-bot, roof-bot, finance-bot, movers-bot) — sharing one would route real
# calls here.
DEMO_AGENT_NAME=voicebot-web

# ── Voicebots on the page ─────────────────────────────────────────────────────
# Which bots the dropdown offers, in order; the first is preselected. Keys are defined
# in demo_bots.py and must also exist in agent_voicebot_web.py. Blank = all of them.
# mortgage and energy are demo-only bots: no telephony service of their own.
DEMO_BOTS=smarthealth,roof,finance,movers,mortgage,energy,warranty
# Each bot's .env, read ONLY for AGENT_NAME and COMPANY_NAME so the script preview shows
# the names the bot will actually use. Defaults shown; set only if moved.
#DEMO_BOT_ENV_SMARTHEALTH=/opt/livekit/bot/.env
#DEMO_BOT_ENV_ROOF=/opt/livekit/roof-bot/.env
#DEMO_BOT_ENV_FINANCE=/opt/livekit/finance-bot/.env
#DEMO_BOT_ENV_MOVERS=/opt/livekit/movers-bot/.env
#DEMO_BOT_ENV_MORTGAGE=/opt/livekit/web-demo/bots/mortgage.env
#DEMO_BOT_ENV_ENERGY=/opt/livekit/web-demo/bots/energy.env
#DEMO_BOT_ENV_WARRANTY=/opt/livekit/warranty-bot/.env

BRAND_COMPANY=BTBIZ
BRAND_AGENT=Sarah

# ── Signup gate ───────────────────────────────────────────────────────────────
# Visitors must submit their details and verify a WhatsApp code before a demo starts.
# Enforced on /api/token, not just in the page. Set to 0 to fall back to one-click
# demos — e.g. if the OTP provider is down mid-pitch. Restart after changing.
DEMO_REQUIRE_SIGNUP=1

OTP_API_BASE=https://wapanel.btbiz.in
# Server-side only. It never reaches the browser.
OTP_API_KEY=
OTP_CODE_LENGTH=6

# Signs the demo pass cookie. Generate once with:  openssl rand -hex 32
# If left blank a random one is used and everyone is signed out on every restart.
DEMO_SESSION_SECRET=

# How long a verified visitor can come back without verifying again.
DEMO_PASS_HOURS=24

# ── Wrong codes: attempts, then a lock ───────────────────────────────────────
# Counted per PHONE NUMBER (and per network), in the database, so a restart doesn't
# clear them and a new code doesn't reset them.
OTP_MAX_ATTEMPTS=3
# Minutes a number is locked for, escalating with each lock. The LAST value repeats:
# "15,60" = 15 minutes the first time, an hour every time after that.
OTP_LOCK_LADDER_MINUTES=15,60
# Quiet for this long and the ladder resets to the first step.
OTP_STRIKE_RESET_HOURS=24
# Wrong codes older than this are forgotten, so three typos a month apart never lock.
OTP_FAIL_WINDOW_MINUTES=60
# Wrong codes from one network across ANY number — stops someone cycling numbers.
OTP_MAX_FAILS_PER_IP=10

# ── Resend ───────────────────────────────────────────────────────────────────
# Seconds before the same number can be sent another code. Enforced here, not just
# counted down in the page.
OTP_RESEND_COOLDOWN_SEC=60
# Codes per number inside the window; asking for one more locks the number.
OTP_MAX_SENDS_PER_PHONE=3
OTP_SEND_WINDOW_MINUTES=15

# ── How many demo calls ──────────────────────────────────────────────────────
# Each one is real STT + LLM + TTS spend. All three are enforced, and the page shows whichever is smallest. Per phone and per
# network are what stop the obvious workaround: filling the form in again.
DEMO_MAX_CALLS_PER_SIGNUP=2
DEMO_MAX_CALLS_PER_PHONE=2
DEMO_MAX_CALLS_PER_IP=2
# Rolling window for the phone and network caps. 0 = for ever (two per number, full
# stop). 24 = two a day, which is usually what you want for a shared office IP.
DEMO_CALL_WINDOW_HOURS=24

# Global ceiling on WhatsApp codes sent — the backstop against form abuse.
OTP_MAX_SENDS_PER_HOUR=60

# Leave 1 in production. Only set 0 to test over plain http://127.0.0.1:8090,
# where browsers refuse to store a Secure cookie.
DEMO_COOKIE_SECURE=1

# Digits only, with country code. Shown as a "Message us on WhatsApp" link.
CONTACT_WHATSAPP=

# Where verified signups are stored. Relative to this folder by default.
# SIGNUPS_DB=/opt/smarthealth-webdemo/demo_signups.db

# ── Company email ──────────────────────────────────────────────────────────────
# Rejects free webmail (Gmail, Yahoo, Outlook...), ISP mailboxes, disposable inboxes
# and placeholders like example.com. A quality filter - it does not prove the address
# exists; that's what email verification will add. 0 turns it off.
EMAIL_REQUIRE_COMPANY=1
# A genuine prospect caught by the rules? Add their domain (comma-separated).
EMAIL_ALLOW_DOMAINS=
# Extra domains to reject, on top of the built-in list.
EMAIL_BLOCK_DOMAINS=

# ── Limits ────────────────────────────────────────────────────────────────────
# Each start spawns a real agent. Global ceiling per 10 minutes, across all visitors.
DEMO_MAX_STARTS_PER_10MIN=12

# Legacy access code. Superseded by the signup gate; leave blank.
DEMO_PASSCODE=
