# /opt/livekit/roof-bot/.env — copy to .env and fill in.
#
# SEPARATE from /opt/livekit/bot/.env on purpose: this campaign posts to a different
# CRM. Keys that are genuinely shared (LiveKit, Deepgram, Anthropic) are duplicated
# here rather than symlinked, so rotating one campaign can never break the other.

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=APIKEY
LIVEKIT_API_SECRET=paste-the-same-secret-as-livekit.yaml

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ── Identity (all spoken) ────────────────────────────────────────────────────
COMPANY_NAME=Building Regulatory Services
# The voice introduces itself by this name in the opening line, so set it deliberately.
AGENT_NAME=Emma
# Only used if a prospect asks for a number to call back on. Leave blank and the bot
# says the adviser will provide it.
CONTACT_NUMBER=

# ── Stack ────────────────────────────────────────────────────────────────────
STT_LANGUAGE=en-GB
# Aura model ids ARE the voice. Leave blank to use the built-in British default.
# ⚠️ A wrong id returns 400 on EVERY turn, which sounds exactly like a mute bot —
# verify against Deepgram's current voice list before the first live call.
TTS_VOICE=

# ── Call behaviour ───────────────────────────────────────────────────────────
# This script is shorter than the Smart Health one; 300s is generous.
# Keep TimeoutStopSec in roof-bot.service ABOVE this value.
MAX_CALL_SECONDS=300
NUDGE_AFTER=8

# ── Disposition — the whole reason this file is separate ─────────────────────
DISPOSITION_WEBHOOK_URL=
DISPOSITION_WEBHOOK_TOKEN=
DISPOSITION_CSV_PATH=/opt/livekit/roof-bot/disposition_roof.csv

# ── Worker identity. Change these only if you also change the dispatch rule. ─
ROOF_AGENT_NAME=roof-bot
# 8081 = smarthealth-bot, 8082 = smarthealth-web. Must not collide.
ROOF_WORKER_HTTP_PORT=8083
