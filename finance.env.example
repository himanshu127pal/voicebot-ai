# /opt/livekit/finance-bot/.env — copy to .env and fill in.
#
# SEPARATE from the other campaigns' .env files on purpose: this campaign posts to a
# different endpoint. Keys that are genuinely shared (LiveKit, Deepgram, Anthropic) are
# duplicated here rather than symlinked, so rotating one campaign can never break
# another.

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=APIKEY
LIVEKIT_API_SECRET=paste-the-same-secret-as-livekit.yaml

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ── Identity (all spoken) ────────────────────────────────────────────────────
COMPANY_NAME=Quick Funding
# The voice introduces itself by this name in the opening line, so set it deliberately.
AGENT_NAME=Sophie

# Given ONLY if a prospect asks. Leave blank and the bot says the details will be in
# the email — it will never invent a web address or a phone number.
COMPANY_WEBSITE=
CONTACT_NUMBER=

# ── Stack ────────────────────────────────────────────────────────────────────
STT_LANGUAGE=en-AU
# Aura model ids ARE the voice. Leave blank to use aura-2-theia-en, the Australian
# voice already running on the Smart Health campaign — unlike the UK voice, this one
# does not need verifying before the first live call.
TTS_VOICE=

# ── Script behaviour ─────────────────────────────────────────────────────────
# The written script asks about employment and income only on the "starting or buying
# a business" path. A pure personal-loan lead with no income information is not
# workable by a broker, so by default the bot asks the same two questions there too —
# clearly optional, never required, dropped the moment they'd rather not say.
# Set 0 to follow the written script to the letter.
ASK_INCOME_ON_PERSONAL=1

# ── Call behaviour ───────────────────────────────────────────────────────────
# Two qualification branches plus an email capture; 420s (7 min) matches Smart Health.
# Keep TimeoutStopSec in finance-bot.service ABOVE this value.
MAX_CALL_SECONDS=420
NUDGE_AFTER=8

# Hang up on an IVR / voicemail / another company's AI on the opening turns.
# Leave on. See the _MACHINE_MARKERS comment in agent_finance_au.py for why.
MACHINE_GUARD=1
MACHINE_GUARD_TURNS=3

# ── Disposition — the whole reason this file is separate ─────────────────────
# Point this at the FINANCE endpoint. Getting it wrong posts loan leads into the
# health insurance or roof tables.
DISPOSITION_WEBHOOK_URL=http://127.0.0.1:8095/disposition/finance
DISPOSITION_WEBHOOK_TOKEN=
DISPOSITION_CSV_PATH=/opt/livekit/finance-bot/disposition_finance.csv

# ── Worker identity. Change these only if you also change the dispatch rule. ─
FINANCE_AGENT_NAME=finance-bot
# 8081 = smarthealth-bot, 8082 = smarthealth-web, 8083 = roof-bot. Must not collide.
FINANCE_WORKER_HTTP_PORT=8084
