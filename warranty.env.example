# /opt/livekit/warranty-bot/.env — copy to .env and fill in.
#
# SEPARATE from the other campaigns' .env files on purpose: this one posts to a different
# CRM. Keys that are genuinely shared (LiveKit, Deepgram, Anthropic) are duplicated here
# rather than symlinked, so rotating one campaign can never break another.
#
# The browser demo reads THIS FILE too (names, plan, voice), but overrides MACHINE_GUARD
# and blanks the webhook for demo calls — see WEB_DEMO.md.

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=APIKEY
LIVEKIT_API_SECRET=paste-the-same-secret-as-livekit.yaml

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ── Identity (all spoken) ────────────────────────────────────────────────────
COMPANY_NAME=Brightwell Home Cover
# The voice introduces itself by this name in the opening line, so set it deliberately.
AGENT_NAME=Hannah
# Given when the customer asks who is calling — on this campaign they WILL ask, and
# "I can't tell you" is what a scam sounds like. Leave blank and the bot offers the
# written details instead.
CONTACT_NUMBER=
COMPANY_WEBSITE=

# ── Stack ────────────────────────────────────────────────────────────────────
STT_LANGUAGE=en-GB
# Aura model ids ARE the voice. pandora is the British feminine voice (roof-bot uses it),
# draco the British masculine one.
# ⚠️ A wrong id returns 400 on EVERY turn, which sounds exactly like a mute bot —
# verify against Deepgram's current voice list before the first live call.
TTS_VOICE=aura-2-pandora-en

# ── The plan — REPLACE WITH THE CLIENT'S REAL COVER ──────────────────────────
# Every figure the bot speaks is computed from these; the model is forbidden from
# inventing, rounding or discounting any of them.
PLAN_PRICE=99
PLAN_MONTHS=12
# Spoken as a list: "engineer call-out, labour, replacement parts and repair costs".
PLAN_INCLUDES=engineer call-out|labour|replacement parts|repair costs
# The oldest appliance this plan will quote for. Above it the bot stops, says cover has
# to be checked, and offers the written details — it never says "no" outright.
MAX_APPLIANCE_YEARS=8

# ── Call behaviour ───────────────────────────────────────────────────────────
# Confirm, qualify, check eligibility, explain, price, take details.
# Keep TimeoutStopSec in warranty-bot.service ABOVE this value.
MAX_CALL_SECONDS=360
NUDGE_AFTER=8

# ── Disposition — the whole reason this file is separate ─────────────────────
DISPOSITION_WEBHOOK_URL=
DISPOSITION_WEBHOOK_TOKEN=
DISPOSITION_CSV_PATH=/opt/livekit/warranty-bot/disposition_warranty.csv

# ── Worker identity. Change these only if you also change the dispatch rule. ─
WARRANTY_AGENT_NAME=warranty-bot
# 8081 smarthealth-bot, 8083 roof-bot, 8084 finance-bot, 8085 voicebot-web,
# 8086 movers-bot. Must not collide.
WARRANTY_WORKER_HTTP_PORT=8087
