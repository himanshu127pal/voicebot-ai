# /etc/systemd/system/warranty-bot.service
#
# UK appliance repair & warranty cover agent — the FIFTH telephony worker on this box.
# Install: see WARRANTY_UK_DEPLOY.md
#
# Shares /opt/livekit/bot/.venv but has its OWN WorkingDirectory and .env, because a
# single .env cannot hold five different DISPOSITION_WEBHOOK_URLs. load_dotenv() resolves
# relative to the script's own directory, so /opt/livekit/warranty-bot/.env is what this
# process reads — no other campaign's config is ever in scope.
#
# The browser demo runs the SAME agent file through voicebot-web.service. Restarting or
# stopping this unit does not affect that, and vice versa.

[Unit]
Description=Brightwell Home Cover — UK appliance warranty agent (warranty-bot)
Documentation=file:///opt/livekit/warranty-bot/WARRANTY_UK_DEPLOY.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/livekit/warranty-bot

# `start` = production mode. NOT `dev` (verbose, no supervision semantics).
# Interpreter comes from the shared venv; the script and its .env do not.
ExecStart=/opt/livekit/bot/.venv/bin/python /opt/livekit/warranty-bot/agent_warranty_uk.py start

# .env is read by load_dotenv() inside the script. Deliberately NOT EnvironmentFile= —
# systemd's parser is stricter than python-dotenv and rejects quoting it accepts.
Environment=PYTHONUNBUFFERED=1
# Silero VAD is CPU-bound and spawns threads per process. With five telephony workers
# plus the demo worker on 4 vCPU the default pool thrashes and shows up in the log as
# "inference slower than realtime". If you see that, add cores — don't tune around it.
Environment=OMP_NUM_THREADS=1

Restart=always
RestartSec=5

# ── Graceful drain — the important part for a VOICE agent ────────────────────
# On stop/restart the worker stops accepting new jobs and finishes calls already in
# progress. Killing it mid-call drops the caller AND loses the disposition webhook.
# Must exceed MAX_CALL_SECONDS (360 for this script).
KillSignal=SIGINT
TimeoutStopSec=420
KillMode=mixed

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=warranty-bot

[Install]
WantedBy=multi-user.target
