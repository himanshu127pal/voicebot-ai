# /opt/disposition-receiver/.env — copy to .env and fill in.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=voicebot
DB_USER=voicebot
# Must match what you put in schema.sql for 'voicebot'@'127.0.0.1'.
DB_PASSWORD=

# Optional shared secret. If set, it MUST equal DISPOSITION_WEBHOOK_TOKEN in BOTH
# bots' .env files, or every POST is rejected 401 and every lead is lost.
# Leave blank on a loopback-only deployment — nothing off-box can reach port 8095.
WEBHOOK_TOKEN=

# Where a lead goes when the INSERT fails. Replay instructions are in the runbook.
FAILED_LOG=/opt/disposition-receiver/failed_inserts.jsonl
